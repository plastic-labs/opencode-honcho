{
  "name": "@honcho-ai/opencode-honcho",
  "version": "0.2.0",
  "type": "module",
  "description": "Honcho memory integration for OpenCode (1.x and 2.x)",
  "license": "MIT",
  "packageManager": "bun@1.3.9",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "import": "./dist/server.js"
    },
    "./tui": {
      "import": "./dist/tui.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tui.js",
    "server.js",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "bun --eval \"const { rm } = await import('node:fs/promises'); await rm('dist', { recursive: true, force: true })\" && bun build ./src/index.ts ./src/server.ts ./src/tui.ts ./src/capabilities.ts ./src/import.ts --outdir ./dist --target node --external @opencode-ai/plugin --external @opencode/plugin && tsc --emitDeclarationOnly",
    "check": "tsc --noEmit",
    "test": "bun run build && bun test ./tests",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@honcho-ai/harness-plugin-core": "^0.1.0",
    "@honcho-ai/sdk": "^2.4.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.23",
    "@opencode/plugin": "^2.0.16",
    "@types/bun": "^1.2.8",
    "@types/node": "^22.13.9",
    "typescript": "^5.9.3"
  }
}
